# ==========================================
# Hidden Gambit - Local Environment Config
# ==========================================

# 1. Database Connection String (PostgreSQL)
# Get a free database URL from https://neon.tech/ or https://supabase.com/
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# 2. API Server Configuration
# The port the Express backend will listen on
PORT=5000

# 3. Frontend (Vite) Configuration
# These are used when running the frontend dev server.
# Set a different port for the frontend to avoid conflict with the backend.
# BASE_PATH is required by the Vite configuration (usually / for root).
# FRONTEND_PORT=3000
# BASE_PATH=/
